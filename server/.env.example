# --- Core ---
DATABASE_URL="postgresql://hsms:hsms@localhost:5433/hsms"
PORT=4000
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="12h"

# Directory for uploaded society documents (local disk for prototype; swap to S3 later)
UPLOAD_DIR="uploads"

# --- WhatsApp provider ---
# "mock" (default, drives the in-app simulator) or "meta" (real Meta Cloud API - stub only for now)
WHATSAPP_PROVIDER="mock"
# Required only when WHATSAPP_PROVIDER=meta (see src/integrations/whatsapp/MetaWhatsAppProvider.ts)
META_WHATSAPP_TOKEN=""
META_PHONE_NUMBER_ID=""
META_WEBHOOK_VERIFY_TOKEN=""

# --- Payment provider ---
# "mock" (default) | "easypaisa" | "jazzcash" (stubs only for now)
PAYMENT_PROVIDER="mock"
# Mock provider behaviour
MOCK_PAYMENT_DELAY_MS=1500
MOCK_PAYMENT_FAIL_RATE=0
# Required only when PAYMENT_PROVIDER=easypaisa (see src/integrations/payments/EasyPaisaProvider.ts)
EASYPAISA_STORE_ID=""
EASYPAISA_HASH_KEY=""
EASYPAISA_API_BASE=""
# Required only when PAYMENT_PROVIDER=jazzcash (see src/integrations/payments/JazzCashProvider.ts)
JAZZCASH_MERCHANT_ID=""
JAZZCASH_PASSWORD=""
JAZZCASH_INTEGRITY_SALT=""
JAZZCASH_API_BASE=""
